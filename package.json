{
  "name": "odata-tools",
  "version": "0.0.1",
  "description": "OASIS OData tools",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm -r run build && pnpm -r run validate",
    "test": "vitest run --typecheck --coverage",
